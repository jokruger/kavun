#!/usr/bin/env kavun

// Errors as values.
// See docs/examples.md for the explanatory write-up.

io = import("io")

parse_port = func(s) {
  // s.int() raises on a bad parse; the explicit member default is the maybe-missing spelling
  n = s.int(undefined)
  if is_undefined(n)         { return error({code: "bad_format",   input: s}) }
  if n < 1 || n > 65535      { return error({code: "out_of_range", value: n}) }
  return n
}

inputs = ["8080", "70000", "abc", "443"]

for raw in inputs {
  r = parse_port(raw)
  if is_error(r) {
    info = r.value()
    io.print(f"reject {raw}: {info.code}")
  } else {
    io.print(f"accept {raw} -> {r}")
  }
}
