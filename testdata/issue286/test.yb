#!/usr/bin/env kavun
// This test should pass if the interpreter's kavun.Compiler.SetImportExt() was set as `c.SetImportExt(".kvn", ".yb")`.

os := import("os")
uno := import("uno") // it will search uno.kvn and uno.yb
fmt := import("fmt")

expected := ["test", "uno", "dos", "tres", "quatro", "cinco"]
expected = expected.join(" ")
if v := uno.fn("test"); v != expected {
    fmt.printf("relative import test error:\n\texpected: %v\n\tgot     : %v\n",
                expected, v)
    os.exit(1)
}

args := os.args().join(" ")
fmt.println("ok\t", args)
