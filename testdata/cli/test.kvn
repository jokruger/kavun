#!/usr/bin/env kavun

os := import("os")
one := import("one")
io := import("io")
expected := ["test", "one", "two", "three", "four", "five"]
expected = expected.join(" ")
if v := one.fn("test"); v != expected {
    io.print(f"relative import test error:\n\texpected: {expected}\n\tgot     : {v}")
    os.exit(1)
}
args := os.args().join(" ")
io.print("ok\t", args)
